# ========================================================
# RemoteHub Environment Configuration Template
# ========================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=production

# Database Connection
# To use PostgreSQL (Supabase, Neon, Railway, Render), provide DATABASE_URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/remotehub?sslmode=require
# If DATABASE_URL is unset, RemoteHub automatically uses the local SQLite engine.
# DATA_DIR=/path/to/custom/data/directory

# Cryptographic Authentication Secrets
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_key_here
SESSION_HMAC_SECRET=replace_with_a_second_independent_cryptographic_secret_here

# Cross-Origin Resource Sharing (CORS)
# Set to your deployed frontend domain (or comma-separated domains)
CORS_ORIGIN=https://remote-pc-green.vercel.app,http://localhost:5173

# Optional: WebRTC TURN Server Relay (for strict symmetric NATs / enterprise firewalls)
# If omitted, RemoteHub defaults to Google public STUN servers and direct P2P connections.
# TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=remotehub
# TURN_CREDENTIAL=your-strong-turn-credential

# Frontend Build Time Environment Variable (Used in client/ directory during build):
# VITE_API_URL=https://remote-pc-server.onrender.com

