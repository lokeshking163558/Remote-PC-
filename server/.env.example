# ========================================================
# RemoteHub Backend Environment Configuration
# ========================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=production

# Database Connection
# When set, RemoteHub switches from SQLite to PostgreSQL with automated table migrations
# DATABASE_URL=postgresql://user:password@host:5432/remotehub?sslmode=require
# DATA_DIR=./data

# Cryptographic Authentication Secrets
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_key_here
SESSION_HMAC_SECRET=replace_with_a_second_independent_cryptographic_secret_here

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=https://remote-pc-green.vercel.app,http://localhost:5173

# Optional: WebRTC TURN Relay Configuration
# TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=remotehub
# TURN_CREDENTIAL=your-turn-credential
