# RemoteHub Server Configuration
PORT=5000
NODE_ENV=production

# Cryptographic Secrets
JWT_SECRET=replace-with-a-very-long-random-string-in-production
SESSION_HMAC_SECRET=replace-with-another-long-random-string-for-session-signing

# Optional WebRTC TURN Relay Configuration
# If omitted, public Google STUN servers and direct P2P connections are used
# TURN_SERVER_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=remotehub
# TURN_CREDENTIAL=your-turn-credential

